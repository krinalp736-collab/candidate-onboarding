<% content_for :title, "Complete your profile" %>
<% content_for :step_indicator do %>
  <%= render "onboarding/step_indicator", current: 2 %>
<% end %>

<div class="container" style="max-width: 860px;">
  <%= link_to new_onboarding_upload_path, class: "d-inline-flex align-items-center gap-1 small fw-medium text-secondary mb-3 text-decoration-none" do %>
    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
    </svg>
    Back to upload
  <% end %>

  <div class="mb-4">
    <h1 class="h3 fw-semibold mb-2">Review and complete your profile</h1>
    <p class="text-secondary mb-0">
      We've filled in what we could find on your CV. Fields marked
      <span class="badge text-bg-warning">Please check</span>
      were extracted automatically — take a look before saving.
    </p>
  </div>

  <% if @profile.errors.any? %>
    <div class="alert alert-danger">
      <p class="fw-medium mb-1">Please fix the following before saving:</p>
      <ul class="mb-0 ps-3">
        <% @profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @profile, url: onboarding_profile_path(@profile), method: :patch,
                 builder: BootstrapFormBuilder,
                 data: {
                   controller: "conditional-fields",
                   conditional_fields_clinical_job_function_ids_value: @job_functions.select(&:clinical?).map { |jf| jf.id.to_s }.to_json
                 } do |f| %>

    <%# 1. Personal details %>
    <section class="card shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold">Personal details</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">First name *</label>
            <%= f.text_field :first_name %>
          </div>
          <div class="col-md-6">
            <label class="form-label">Last name *</label>
            <%= f.text_field :last_name %>
          </div>
          <div class="col-md-6">
            <label class="form-label">Email *</label>
            <%= f.email_field :email %>
          </div>
          <div class="col-md-6">
            <label class="form-label">Phone number *</label>
            <%= f.telephone_field :phone_number %>
          </div>
          <div class="col-md-6">
            <label class="form-label">City / place of residence *</label>
            <%= f.text_field :city %>
          </div>
          <div class="col-md-6">
            <label class="form-label">Country</label>
            <%= f.text_field :country %>
          </div>
        </div>

        <div class="mt-3">
          <label class="form-label">Languages *</label>
          <div class="list-group <%= group_validation_class(@profile, :languages) %>">
            <% @languages.each do |language| %>
              <% candidate_language = @profile.candidate_languages.find { |cl| cl.language_id == language.id } %>
              <div class="list-group-item d-flex flex-wrap align-items-center gap-3">
                <div class="form-check flex-grow-1 mb-0">
                  <input type="checkbox" name="candidate_profile[language_ids][]" value="<%= language.id %>"
                         <%= "checked" if candidate_language %>
                         class="form-check-input" id="language_<%= language.id %>">
                  <label class="form-check-label" for="language_<%= language.id %>"><%= language.name %></label>
                </div>
                <input type="text" name="candidate_profile[language_levels][<%= language.id %>]"
                       value="<%= candidate_language&.level %>" placeholder="e.g. B2, fluent, native"
                       class="form-control form-control-sm" style="max-width: 12rem;">
              </div>
            <% end %>
            <input type="hidden" name="candidate_profile[language_ids][]" value="">
          </div>
          <%= group_validation_feedback(@profile, :languages) %>
        </div>
      </div>
    </section>

    <%# 2. Job preferences %>
    <section class="card shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold">Job preferences</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Desired job function *</label>
            <%= f.select :job_function_id, @job_functions.map { |jf| [ jf.name, jf.id ] }, { include_blank: true },
                         data: { "conditional-fields-role": "job-function", action: "change->conditional-fields#refresh" } %>
          </div>
          <div class="col-md-6">
            <label class="form-label">Maximum travel time (minutes) *</label>
            <%= f.number_field :max_travel_time %>
          </div>
          <div class="col-12">
            <label class="form-label">Preferred regions *</label>
            <%= f.text_field :preferred_regions_text, placeholder: "e.g. Amsterdam, Utrecht, Rotterdam" %>
            <div class="form-text">Separate multiple regions with commas.</div>
          </div>
          <div class="col-12">
            <span class="form-label d-block">Transport</span>
            <% CandidateProfile::TRANSPORT_TYPES.each do |type| %>
              <div class="form-check form-check-inline">
                <%= check_box_tag "candidate_profile[transport_types][]", type, @profile.transport_types.include?(type),
                                   id: "transport_#{type}", class: "form-check-input" %>
                <label class="form-check-label" for="transport_<%= type %>"><%= type.humanize %></label>
              </div>
            <% end %>
          </div>
          <div class="col-md-6">
            <label class="form-label">Search status *</label>
            <%= f.select :search_status, CandidateProfile.search_statuses.keys.map { |k| [ k.humanize, k ] }, include_blank: true %>
          </div>
          <div class="col-12">
            <label class="form-label">Reason for looking</label>
            <%= f.text_area :reason_for_looking, rows: 2 %>
          </div>
        </div>
      </div>
    </section>

    <%# 3. Employment and compensation %>
    <section class="card shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold">Employment and compensation</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-12">
            <span class="form-label d-block">Desired employment type *</span>
            <div class="<%= group_validation_class(@profile, :employment_types) %>">
              <% CandidateProfile::EMPLOYMENT_TYPES.each do |type| %>
                <div class="form-check form-check-inline">
                  <%= check_box_tag "candidate_profile[employment_types][]", type, @profile.employment_types.include?(type),
                                     id: "employment_#{type}", class: "form-check-input",
                                     data: { "conditional-fields-role": "employment-type", action: "change->conditional-fields#refresh" } %>
                  <label class="form-check-label" for="employment_<%= type %>"><%= type.humanize %></label>
                </div>
              <% end %>
              <%# Without this, unchecking every box drops the key entirely and the previous selection silently survives. %>
              <input type="hidden" name="candidate_profile[employment_types][]" value="">
            </div>
            <%= group_validation_feedback(@profile, :employment_types) %>
          </div>

          <div class="col-md-6" data-conditional-fields-target="salaryField">
            <label class="form-label">Desired gross salary</label>
            <%= f.number_field :desired_gross_salary %>
          </div>
          <div class="col-md-6" data-conditional-fields-target="percentageField">
            <label class="form-label">Desired percentage</label>
            <%= f.number_field :desired_percentage, min: 0, max: 100 %>
          </div>
          <div class="col-md-6" data-conditional-fields-target="revenueField">
            <label class="form-label">Average daily revenue</label>
            <%= f.number_field :average_daily_revenue %>
          </div>
          <div class="col-md-6">
            <label class="form-label">Years of combined dental experience *</label>
            <%= f.number_field :years_of_experience, min: 0 %>
          </div>

          <div class="col-md-6" data-conditional-fields-target="bigFields">
            <label class="form-label">BIG registration status</label>
            <%= f.select :big_registration_status, CandidateProfile.big_registration_statuses.keys.map { |k| [ k.humanize, k ] }, include_blank: true %>
          </div>
          <div class="col-md-6" data-conditional-fields-target="bigFields">
            <label class="form-label">BIG number</label>
            <%= f.text_field :big_number %>
          </div>
        </div>
      </div>
    </section>

    <%# 4. Education %>
    <section class="card shadow-sm mb-4" data-controller="nested-fields">
      <div class="card-header bg-white fw-semibold">Education</div>
      <div class="card-body">
        <% if @profile.educations.reject(&:marked_for_destruction?).empty? %>
          <p class="small text-secondary mb-3">No education added yet.</p>
        <% end %>

        <%= f.fields_for :educations do |ed_f| %>
          <%= render "education_fields", f: ed_f, education: ed_f.object %>
        <% end %>

        <div data-nested-fields-target="target"></div>

        <template data-nested-fields-target="template">
          <%= f.fields_for :educations, Education.new, child_index: "NEW_RECORD" do |ed_f| %>
            <%= render "education_fields", f: ed_f, education: ed_f.object %>
          <% end %>
        </template>

        <button type="button" data-action="nested-fields#add" class="btn btn-link px-0">+ Add education</button>
      </div>
    </section>

    <%# 5. Work experience %>
    <section class="card shadow-sm mb-4" data-controller="nested-fields">
      <div class="card-header bg-white fw-semibold">Work experience</div>
      <div class="card-body">
        <% if @profile.work_experiences.reject(&:marked_for_destruction?).empty? %>
          <p class="small text-secondary mb-3">No work experience added yet.</p>
        <% end %>

        <%= f.fields_for :work_experiences do |we_f| %>
          <%= render "work_experience_fields", f: we_f, work_experience: we_f.object %>
        <% end %>

        <div data-nested-fields-target="target"></div>

        <template data-nested-fields-target="template">
          <%= f.fields_for :work_experiences, WorkExperience.new, child_index: "NEW_RECORD" do |we_f| %>
            <%= render "work_experience_fields", f: we_f, work_experience: we_f.object %>
          <% end %>
        </template>

        <button type="button" data-action="nested-fields#add" class="btn btn-link px-0">+ Add work experience</button>
      </div>
    </section>

    <%# 6. Skills %>
    <section class="card shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold">Skills</div>
      <div class="card-body">
        <% @job_functions.each do |job_function| %>
          <div data-conditional-fields-target="skillGroup" data-job-function-id="<%= job_function.id %>"
               class="mb-3 <%= "d-none" unless @profile.job_function_id == job_function.id %>">
            <p class="small fw-medium mb-2"><%= job_function.name %> skills</p>
            <% (@skills_by_job_function[job_function.id] || []).each do |skill| %>
              <div class="form-check form-check-inline">
                <%= check_box_tag "candidate_profile[skill_ids][]", skill.id, @profile.skill_ids.include?(skill.id),
                                   id: "skill_#{skill.id}", class: "form-check-input" %>
                <label class="form-check-label" for="skill_<%= skill.id %>"><%= skill.name %></label>
              </div>
            <% end %>
          </div>
        <% end %>
        <input type="hidden" name="candidate_profile[skill_ids][]" value="">

        <div class="mt-2">
          <label class="form-label">Other skills</label>
          <input type="text" name="candidate_profile[other_skills_text]"
                 value="<%= @profile.candidate_skills.select { |cs| cs.skill_id.nil? }.map(&:suggested_name).join(", ") %>"
                 placeholder="Comma-separated — sent to recruiters for review"
                 class="form-control">
        </div>
      </div>
    </section>

    <%# 7. Availability %>
    <section class="card shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold">Availability</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-12">
            <span class="form-label d-block">Available working days *</span>
            <div class="<%= group_validation_class(@profile, :available_working_days) %>">
              <% CandidateProfile::WORKING_DAYS.each do |day| %>
                <div class="form-check form-check-inline">
                  <%= check_box_tag "candidate_profile[available_working_days][]", day, @profile.available_working_days.include?(day),
                                     id: "day_#{day}", class: "form-check-input" %>
                  <label class="form-check-label" for="day_<%= day %>"><%= day.humanize %></label>
                </div>
              <% end %>
              <input type="hidden" name="candidate_profile[available_working_days][]" value="">
            </div>
            <%= group_validation_feedback(@profile, :available_working_days) %>
          </div>
          <div class="col-md-6">
            <label class="form-label">Available from *</label>
            <%= f.date_field :available_from %>
          </div>
          <div class="col-md-6">
            <label class="form-label">Notice period</label>
            <%= f.text_field :notice_period %>
          </div>
        </div>
      </div>
    </section>

    <%# 8. Additional information %>
    <section class="card shadow-sm mb-4">
      <div class="card-header bg-white fw-semibold">Additional information</div>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label">Professional summary</label>
          <%= f.text_area :professional_summary, rows: 3 %>
        </div>
        <div class="mb-3">
          <label class="form-label">Motivation for employer</label>
          <%= f.text_area :motivation, rows: 3 %>
        </div>
        <div class="mb-0">
          <label class="form-label">Internal notes for recruitment team</label>
          <%= f.text_area :internal_notes, rows: 2 %>
        </div>
      </div>
    </section>

    <div class="d-flex justify-content-end mb-5">
      <%= f.submit "Save profile", class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>
