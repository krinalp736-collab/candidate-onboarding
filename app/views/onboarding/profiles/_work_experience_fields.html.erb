<div class="border rounded p-3 mb-3" data-nested-fields-target="fields">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy %>

  <div class="d-flex justify-content-between align-items-start mb-2">
    <% if work_experience.extracted? %>
      <span class="badge text-bg-warning">
        <%= work_experience.needs_review? ? "Please check — extracted from CV" : "Extracted from CV" %>
      </span>
    <% else %>
      <span></span>
    <% end %>
    <button type="button" data-action="nested-fields#remove" class="btn btn-link btn-sm text-danger p-0">Remove</button>
  </div>

  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Job title *</label>
      <%= f.text_field :job_title %>
    </div>
    <div class="col-md-6">
      <label class="form-label">Company name *</label>
      <%= f.text_field :company_name %>
    </div>
    <div class="col-12">
      <label class="form-label">Responsibilities</label>
      <%= f.text_area :responsibilities, rows: 2 %>
    </div>
    <div class="col-md-6">
      <label class="form-label">Start date</label>
      <%= f.date_field :start_date %>
    </div>
    <div class="col-md-6">
      <label class="form-label">End date</label>
      <%= f.date_field :end_date %>
    </div>
    <div class="col-12">
      <div class="form-check">
        <%= f.check_box :current_job, class: "form-check-input" %>
        <label class="form-check-label">I currently work here</label>
      </div>
    </div>
  </div>
</div>
