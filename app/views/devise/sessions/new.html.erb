<% content_for :title, "Log in" %>

<div class="container d-flex justify-content-center">
  <div class="card shadow-sm mt-5 mb-5" style="max-width: 420px; width: 100%;">
    <div class="card-body p-4">
      <h1 class="h4 fw-semibold mb-4"><%= resource_name == :admin_user ? "Admin log in" : "Log in" %></h1>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), builder: BootstrapFormBuilder) do |f| %>
        <div class="mb-3">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-check mb-3">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, class: "form-check-label" %>
          </div>
        <% end %>

        <div class="d-grid">
          <%= f.submit "Log in", class: "btn btn-primary" %>
        </div>
      <% end %>

      <div class="mt-3 small">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
